{
  "name": "@meddleware/design-tokens",
  "version": "0.1.10",
  "description": "Framework-agnostic design tokens (warm-neutral canvas, functional accents) for @meddleware UIs — CSS custom properties + JS/JSON exports.",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/design-tokens.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens.css",
    "./seasons.css": "./src/seasons.css",
    "./tokens.json": "./src/tokens.json"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "check:sync": "node scripts/check-token-sync.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "lint": "npm run lint:css",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:css": "node scripts/check-css-contract.mjs",
    "test": "node --test tests/check-css-contract.test.mjs tests/sync-comments.test.mjs tests/sync-mirror.test.mjs tests/check-contrast.test.mjs tests/entry-import.test.mjs",
    "check": "npm run check:versions && npm run check:sync && npm run check:contrast && npm run check:css && npm test"
  },
  "devDependencies": {
    "jsr": "0.14.3",
    "postcss": "^8.5.29",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
