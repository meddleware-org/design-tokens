{
  "name": "@meddleware/design-tokens",
  "version": "0.1.8",
  "description": "Framework-agnostic design tokens (Oxblood/Indigo palette) for @meddleware UIs — CSS custom properties + JS/JSON exports.",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/design-tokens.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens.css",
    "./seasons.css": "./src/seasons.css",
    "./tokens.json": "./src/tokens.json"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "check:sync": "node scripts/check-token-sync.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "lint": "npm run lint:css"
  },
  "devDependencies": {
    "postcss": "^8.4.49",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~7.0.2"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
